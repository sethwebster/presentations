# =============================================================================
# Lume Presentation Framework - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# Database & Caching
# =============================================================================

# Redis connection URL for caching and real-time features
# Example: redis://localhost:6379 or redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# Vercel KV (Redis by Upstash) - alternative to REDIS_URL for production
# Get from Vercel dashboard: https://vercel.com/docs/storage/vercel-kv
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Namespace prefix for Redis keys to avoid collisions
REDIS_NAMESPACE=lume

# =============================================================================
# Authentication (NextAuth.js)
# =============================================================================

# Secret key for encrypting session tokens and cookies
# Generate with: openssl rand -base64 64
NEXTAUTH_SECRET=your-nextauth-secret-here

# Base URL for authentication callbacks
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth Application credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Presenter Authentication
# =============================================================================

# Secret password for presenter control and slide advancement
# Generate a long random secret: openssl rand -base64 32
# REQUIRED in production - app will fail if not set
LUME_CONTROL_SECRET=

# =============================================================================
# AI & Content Generation
# =============================================================================

# OpenAI API key for AI features (slide generation, voice autopilot, etc.)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Fireworks AI API key for additional AI capabilities
# Get yours at: https://fireworks.ai
FIREWORKS_API_KEY=fw_your-fireworks-api-key-here

# =============================================================================
# Email
# =============================================================================

# Resend API key for transactional emails
# Get yours at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key-here

# Email address to send from (must be verified in Resend)
RESEND_FROM=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com

# Alternative SMTP configuration (if not using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable thumbnail generation for deck previews
# Set to 'false' to disable and improve performance
# Default: true
ENABLE_THUMBNAILS=true

# Enable metrics collection
# Set to 'true' to enable
# Default: false
ENABLE_METRICS=false
